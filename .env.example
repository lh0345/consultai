# Copy to .env. Only the Nest server reads secrets.
DATABASE_URL=postgresql://consultai:consultai@127.0.0.1:54329/consultai?schema=public
PORT=3001
APP_ORIGIN=http://localhost:5173
# Hosted mode requires HTTPS and a password of at least 24 characters.
# Leave blank for the existing loopback-only local demonstration.
ADMIN_PASSWORD=
# Hosted bootstrap can seed subjects and initial slots into a new database.
SEED_DEMO=false
# Optional: one Google OAuth web client, redirect URI registered exactly as below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/admin/integrations/google/callback
# Required for Google connection: 64 hexadecimal characters (32 random bytes).
TOKEN_ENCRYPTION_KEY=
# Optional; the whole booking app works with these blank.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
